{
  "timezone": "Asia/Singapore",
  "reminders_list": "Student Plan",
  "evening_rollover": {
    "hour": 21,
    "minute": 0,
    "preserve_time_of_day": true
  },
  "planning": {
    "max_daily_outcomes": 3,
    "buffer_ratio": 0.2
  },
  "providers": {
    "ntulearn": {
      "mode": "authenticated_browser",
      "url": "https://ntulearn.ntu.edu.sg/"
    },
    "outlook": {
      "mode": "authenticated_browser",
      "calendar_url": "https://outlook.office.com/calendar/",
      "mail_url": "https://outlook.office.com/mail/"
    },
    "telegram": {
      "mode": "provided_export_or_authenticated_browser"
    },
    "local": {
      "mode": "directory",
      "root": "~/Documents/Study Planner Sources",
      "recursive": true
    }
  }
}
